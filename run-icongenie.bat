@echo off
powershell.exe -NoExit -NoLogo -ExecutionPolicy Bypass -Command "Set-Location '%~dp0'; if (-not (pnpm list --depth 0 '@quasar/icongenie' 2>$null | Select-String '@quasar/icongenie')) { Write-Warning '@quasar/icongenie is not installed. Run: pnpm add -D @quasar/icongenie'; exit 1 }; $nodeVer = [int]((node --version).TrimStart('v').Split('.')[0]); if ($nodeVer -ge 22) { Write-Host \"Node $nodeVer detected - sharp 0.32 does not support Node 22+. Upgrading @quasar/icongenie and applying sharp override...\" -ForegroundColor Cyan; pnpm add -D '@quasar/icongenie@latest'; if ($LASTEXITCODE -ne 0) { Write-Warning 'Upgrade failed. Aborting.'; exit 1 }; pnpm install; if ($LASTEXITCODE -ne 0) { Write-Warning 'pnpm install failed. Aborting.'; exit 1 } }; Write-Host 'Running icongenie generate...' -ForegroundColor Green; pnpm exec icongenie generate -i public/pdlm-logo.png"
