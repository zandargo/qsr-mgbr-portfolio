@echo off
powershell.exe -NoExit -NoLogo -ExecutionPolicy Bypass -Command "$env:PATH = 'C:\dev\node-portable-v22;C:\dev\node-portable-v22\node_modules\.bin;' + $env:PATH; Set-Location '%~dp0'; if (-not (Get-Command firebase -ErrorAction SilentlyContinue)) { Write-Host 'Installing firebase-tools...'; npm install -g firebase-tools }; $loginStatus = firebase login:list 2>&1; if ($loginStatus -notmatch '@') { Write-Host 'Not logged in. Starting Firebase login...'; firebase login }; Write-Host ''; Write-Host 'What do you want to deploy?'; Write-Host '  [1] Rules (Firestore + Storage)'; Write-Host '  [2] Dist / PWA (hosting:madsongermano)'; Write-Host '  [3] Indexes (Firestore)'; Write-Host ''; $choice = Read-Host 'Enter 1, 2 or 3'; if ($choice -eq '2') { Write-Host 'Deploying PWA to hosting:madsongermano...'; firebase deploy --project madsonbr --only hosting:madsongermano } elseif ($choice -eq '1') { Write-Host 'Deploying rules to madsongermano...'; firebase deploy --project madsonbr --only firestore:rules,storage } elseif ($choice -eq '3') { Write-Host 'Deploying indexes to madsongermano...'; firebase deploy --project madsonbr --only firestore:indexes } else { Write-Host 'Invalid choice. Exiting.'; exit 1 }"
